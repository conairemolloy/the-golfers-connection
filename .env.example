# Copy this file to .env.local and fill in real values.
# Never commit .env.local.

# Supabase dashboard > Project Settings > Database > Connection string > Session pooler.
# Use the "session pooler" URI (port 5432 via pooler host), not the direct connection.
DATABASE_URL=

# Supabase dashboard > Project Settings > API > Project URL.
NEXT_PUBLIC_SUPABASE_URL=

# Supabase dashboard > Project Settings > API > Project API keys > anon public.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Supabase dashboard > Project Settings > API > Project API keys > service_role secret.
# Server-side only. Never expose to the client.
SUPABASE_SERVICE_ROLE_KEY=
